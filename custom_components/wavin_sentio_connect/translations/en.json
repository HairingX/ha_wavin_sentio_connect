{
  "config": {
    "flow_title": "{name}",
    "step": {
      "discovery_confirm": {
        "title": "Wavin Sentio found",
        "description": "Add the Sentio controller {name} at {host}?"
      },
      "user": {
        "title": "Set up Wavin Sentio",
        "description": "Modbus TCP must be enabled on the controller: System > Installer settings > Modbus configuration > Modbus TCP.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "host": "The IP address or host name of the Sentio controller.",
          "port": "The Modbus TCP port of the controller.",
          "unit_id": "The Modbus unit ID the controller answers to."
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "Change where the controller is reached. It must be the same controller.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "host": "The IP address or host name of the Sentio controller.",
          "port": "The Modbus TCP port of the controller.",
          "unit_id": "The Modbus unit ID the controller answers to."
        }
      }
    },
    "error": {
      "cannot_connect": "Nothing answered at this address, port and unit ID.",
      "unsupported_device": "The device that answered is not a supported Sentio controller.",
      "no_serial_number": "The controller gave no serial number, so it cannot be told apart from others.",
      "invalid_host": "Enter a host.",
      "unknown": "Unexpected error; see the log."
    },
    "abort": {
      "already_configured": "This controller is already configured.",
      "reconfigure_successful": "The connection was changed.",
      "wrong_device": "Another controller answers at this address. Add it as a new controller instead.",
      "cannot_connect": "Nothing answered at the discovered address on the default port and unit ID.",
      "unsupported_device": "The device that answered is not a supported Sentio controller.",
      "no_serial_number": "The controller gave no serial number, so it cannot be told apart from others.",
      "unknown": "Unexpected error; see the log.",
      "already_in_progress": "This controller is already being set up."
    }
  },
