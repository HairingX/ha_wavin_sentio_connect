      "message": "The controller at {host} does not answer."
    },
    "unsupported_device": {
      "message": "The device is not a supported Sentio controller."
    },
    "wrong_device": {
      "message": "Another controller answers at this address: serial number {found}, not {expected}. Reconfigure the entry."
    },
    "modbus_not_writable": {
      "message": "The controller's Modbus mode is {mode}; it does not accept writes from this integration."
    },
    "invalid_value": {
      "message": "The controller cannot take the value {value}."
    },
    "write_refused": {
      "message": "The controller did not accept the change."
    },
    "schedule_has_the_target": {
      "message": "The room follows its schedule. Switch it to heat or cool to set a temperature."
    }
  }
}
